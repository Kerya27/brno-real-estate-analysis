# Postgres connection used by the pipeline, the dashboard and the DB tests.
# Inside Docker Compose the host is "db"; from your machine it is "localhost".
POSTGRES_USER=brno
POSTGRES_PASSWORD=brno
POSTGRES_DB=brno_re
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://brno:brno@localhost:5433/brno_re
# Separate database for pytest integration tests (created by tests if missing)
TEST_DATABASE_URL=postgresql+psycopg://brno:brno@localhost:5433/brno_re_test
